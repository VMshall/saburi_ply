<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %> - Saburi Ply
    </title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', sans-serif;
            line-height: 1.6;
            color: #333;
            background-color: #f8f9fa;
        }

        .container {
            max-width: 600px;
            margin: 0 auto;
            background-color: #ffffff;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        }

        .header {
            background-color: #000000;
            padding: 40px 30px;
            text-align: center;
            border-bottom: 4px solid #e74c3c;
        }

        .logo-img {
            max-width: 150px;
            height: auto;
            margin-bottom: 15px;
        }

        .company-name {
            color: #ffffff;
            font-size: 28px;
            font-weight: 700;
            letter-spacing: -0.5px;
        }

        .header-subtitle {
            color: rgba(255, 255, 255, 0.8);
            font-size: 14px;
            margin-top: 8px;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }

        .content {
            padding: 40px 30px;
        }

        .thank-you-title {
            font-size: 24px;
            color: #1a1a2e;
            margin-bottom: 12px;
            font-weight: 700;
        }

        .thank-you-subtitle {
            font-size: 16px;
            color: #666;
            margin-bottom: 30px;
            line-height: 1.5;
        }

        .message-box {
            background-color: #f0f4ff;
            border-left: 4px solid #e74c3c;
            padding: 20px;
            margin-bottom: 30px;
            border-radius: 4px;
        }

        .message-box p {
            color: #333;
            font-size: 15px;
            line-height: 1.6;
        }

        .next-steps {
            background-color: #f8f9fa;
            padding: 20px;
            border-radius: 4px;
            margin-bottom: 30px;
        }

        .next-steps-title {
            font-size: 14px;
            font-weight: 700;
            color: #1a1a2e;
            margin-bottom: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .next-steps-list {
            list-style: none;
            padding: 0;
        }

        .next-steps-list li {
            padding: 8px 0;
            color: #666;
            font-size: 14px;
            line-height: 1.5;
        }

        .footer {
            background-color: #1a1a2e;
            color: rgba(255, 255, 255, 0.8);
            padding: 30px;
            text-align: center;
            font-size: 13px;
            border-top: 4px solid #e74c3c;
        }

        .footer-title {
            color: #ffffff;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .footer-contact {
            margin: 12px 0;
            line-height: 1.6;
        }

        .footer-contact a {
            color: #e74c3c;
            text-decoration: none;
        }

        .footer-contact a:hover {
            text-decoration: underline;
        }

        .data-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        .data-table th,
        .data-table td {
            text-align: left;
            padding: 10px;
            border-bottom: 1px solid #eee;
        }

        .data-table th {
            width: 30%;
            color: #1a1a2e;
            font-weight: 700;
        }
    </style>
</head>

<body>
    <div class="container">
        <!-- Header -->
        <div class="header">
            <img src="cid:site_logo" alt="Saburi Ply Logo" class="logo-img">
        </div>

        <!-- Content -->
        <div class="content">
            <%- body %>
        </div>

        <!-- Footer -->
        <div class="footer">
            <p class="footer-title">SABURI PLY</p>
            <div class="footer-contact">
                <p>📍 New Town Square, Unit 3A, Atghora Rajarhat, Chinar Park Crossing, Kolkata – 700 136, West Bengal,
                    India</p>
                <p>📞 1800 313 666 000 | 📧 <a href="mailto:info@saburiply.com">info@saburiply.com</a></p>
                <p>🌐 <a href="https://www.saburiply.com">www.saburiply.com</a></p>
                <p>⏰ Monday - Saturday: 10:00 AM - 8:00 PM</p>
            </div>
            <p style="margin-top: 20px; font-size: 12px;">© 2026 Saburi Ply Ltd. All rights reserved.</p>
        </div>
    </div>
</body>

</html>