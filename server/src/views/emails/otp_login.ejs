<h2 class="thank-you-title" style="text-align: center;">Your Login OTP</h2>
<p class="thank-you-subtitle" style="text-align: center;">Please use the following One-Time Password to log in to your
    account.</p>

<div class="message-box" style="text-align: center; border-left: none; background-color: #f8f9fa;">
    <span style="font-size: 32px; font-weight: bold; letter-spacing: 5px; color: #2c3e50;">
        <%= otp %>
    </span>
</div>

<div class="next-steps">
    <p class="next-steps-title" style="text-align: center; color: #999;">Security Information</p>
    <ul class="next-steps-list" style="text-align: center; list-style-position: inside;">
        <li>This code will expire in 10 minutes.</li>
        <li>If you did not request this code, please ignore this email.</li>
        <li>Do not share this code with anyone.</li>
    </ul>
</div>