{
    "info": {
        "_postman_id": "new-saburi-save-data-apis",
        "name": "New Saburi APIs - Save Data",
        "description": "Postman Collection for the newly created Save Data Web and Admin APIs",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Public Web API",
            "item": [
                {
                    "name": "Create Save Data",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"John Doe\",\n    \"email\": \"john@example.com\",\n    \"phone_number\": \"9876543210\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/api/web/v1/save-data",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "web",
                                "v1",
                                "save-data"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Admin API",
            "item": [
                {
                    "name": "List Saved Data",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{admin_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/admin/save-data?page=1&limit=10",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "admin",
                                "save-data"
                            ],
                            "query": [
                                {
                                    "key": "page",
                                    "value": "1"
                                },
                                {
                                    "key": "limit",
                                    "value": "10"
                                },
                                {
                                    "key": "name",
                                    "value": "John",
                                    "disabled": true
                                },
                                {
                                    "key": "email",
                                    "value": "john@example.com",
                                    "disabled": true
                                },
                                {
                                    "key": "phone_number",
                                    "value": "9876543210",
                                    "disabled": true
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Get Single Saved Data",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{admin_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/admin/save-data/1",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "admin",
                                "save-data",
                                "1"
                            ]
                        }
                    }
                },
                {
                    "name": "Delete Saved Data",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{admin_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/admin/save-data/1",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "admin",
                                "save-data",
                                "1"
                            ]
                        }
                    }
                },
                {
                    "name": "Download CSV",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{admin_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/admin/save-data/download_csv",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "admin",
                                "save-data",
                                "download_csv"
                            ]
                        }
                    }
                },
                {
                    "name": "Download PDF",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{admin_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/admin/save-data/download-pdf-format",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "admin",
                                "save-data",
                                "download-pdf-format"
                            ]
                        }
                    }
                }
            ]
        }
    ],
    "variable": [
        {
            "key": "base_url",
            "value": "https://apiv2.saburiply.com"
        },
        {
            "key": "admin_token",
            "value": "YOUR_TOKEN_HERE"
        }
    ]
}
